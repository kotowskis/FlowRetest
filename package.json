{
  "name": "flowretest-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "check:deps": "node scripts/check-no-n8n-deps.mjs",
    "verify": "npm run check:deps && npm run lint && npm run type-check && npm run test",
    "schemas": "node scripts/export-schemas.mjs",
    "lint": "eslint ."
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24",
    "eslint": "^9.39.5",
    "turbo": "^2",
    "typescript": "^5.9",
    "typescript-eslint": "^8.70.1"
  }
}
