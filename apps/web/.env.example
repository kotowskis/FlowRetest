# Test mode (ADR 0019): `npm run test-mode` needs none of this file; it passes its own settings, including
# FLOWRETEST_TEST_MODE=true, which is ignored unless APP_URL and the Supabase URL are on localhost.
# Values printed by `npm run db:start -w @flowretest/web` (local Supabase on ports 553xx).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://127.0.0.1:3100
# Outgoing mail (notifications). Local: Mailpit from db:start. Production provider not chosen yet (ADR 0008):
# RESEND_API_KEY switches to Resend; without either variable messages are only logged.
MAILPIT_URL=http://127.0.0.1:55324
# RESEND_API_KEY=
# MAIL_FROM=FlowRetest <noreply@example.com>
# Billing (ADR 0010). Without both keys the billing page shows the plans and takes no payments.
# Locally `node scripts/fake-services.mjs init` points these at the fake Stripe; for a real account run
# scripts/stripe-setup.mjs once to create the prices and the webhook endpoint.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_AUTOMATIC_TAX=true   # true after tax registrations are set up in Stripe Tax; a live key needs true or false
# STRIPE_TRIAL_DAYS=14        # free trial of the first paid plan (ADR 0017); 0 turns it off
# STRIPE_API_URL=https://api.stripe.com   # the fake Stripe sets http://127.0.0.1:55390/stripe
# GitHub App (ADR 0009, 0012). Without these the workspace page says GitHub is not configured.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=   # PEM, one line with \n is fine
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_WEBHOOK_SECRET=
# GITHUB_APP_API_URL=https://api.github.com   # not GITHUB_API_URL: GitHub Actions sets that one on every runner
# GITHUB_APP_WEB_URL=https://github.com
# Slack: only hooks.slack.com is accepted; extra hosts for the fake services in development and tests.
# SLACK_WEBHOOK_HOSTS=127.0.0.1:55390
# Legal pages and the DPA copy (ADR 0015). Without all four and LEGAL_FINAL=true the texts show a draft banner, and
# owners cannot accept the draft DPA unless LEGAL_ALLOW_DRAFT_ACCEPTANCE=true (db:env sets it for local use and CI).
# LEGAL_NAME=Skynappse Sp. z o.o.
# LEGAL_ADDRESS=
# LEGAL_COMPANY_ID=KRS ..., NIP PL...
# LEGAL_EMAIL=privacy@example.com
# LEGAL_FINAL=true
# LEGAL_ALLOW_DRAFT_ACCEPTANCE=true   # local stack and CI only: ignored unless APP_URL is on localhost (ADR 0018)
# SALES_EMAIL=hello@example.com   # "talk to us" on the home page; LEGAL_EMAIL when unset
