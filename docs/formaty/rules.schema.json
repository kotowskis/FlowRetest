{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowretest.dev/schemas/rules.schema.json",
  "title": "flowretest rules",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "match": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "respond": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "json": {},
              "body": {
                "type": "string"
              },
              "close": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "times": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "match",
          "respond"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "rules"
  ],
  "additionalProperties": false
}
