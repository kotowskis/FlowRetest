{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowretest.dev/schemas/stubs.schema.json",
  "title": "flowretest stubs",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "stubs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "stubs"
  ]
}
