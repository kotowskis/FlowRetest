{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowretest.dev/schemas/expectations.schema.json",
  "title": "flowretest expectations",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "expect": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "minLength": 1
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "max": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "notEmpty",
                    "absent",
                    "present"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "notEmpty": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "notEmpty"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "absent": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "absent"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "present": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "present"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "equals": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "equals"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "matches": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "matches"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "oneOf": {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    }
                  },
                  "required": [
                    "oneOf"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "node"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "expect"
  ]
}
