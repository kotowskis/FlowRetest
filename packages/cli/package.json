{
  "name": "flowretest",
  "version": "0.3.0-next.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proxy.lock.json",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "e2e": "node --test \"e2e/**/*.test.ts\""
  },
  "dependencies": {
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "bin": {
    "flowretest": "dist/bin.js"
  },
  "description": "Replay real n8n executions against a changed workflow in a sealed sandbox and diff the calls it would send.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "n8n",
    "testing",
    "regression",
    "workflow",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skynappse/flowretest"
  },
  "devDependencies": {
    "@flowretest/core": "*",
    "@flowretest/schemas": "*",
    "@flowretest/services": "*",
    "esbuild": "^0.28.2"
  }
}
